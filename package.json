{
  "name": "mestrelo",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "migrate": "tsx server/db/migrate.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "framer-motion": "^12.42.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.22.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.4",
    "dotenv": "^16.4.5",
    "express-rate-limit": "^7.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.8.2",
    "vite": "^5.4.11",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4"
  }
}